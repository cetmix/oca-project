<odoo>
    <template id="portal_tasks_list_override" inherit_id="project.portal_tasks_list">
        <xpath expr="//td[contains(@class, 'text-start')]/span[@t-esc='task.id']" position="replace">
            <span t-esc="task.code"/>
        </xpath>
        <xpath expr="//a[contains(@t-attf-href, '/my/')]" position="replace">
            <a t-attf-href="/my/#{task_url}/#{task.code}?{{ keep_query() }}">
                <span t-field="task.name"/>
            </a>
        </xpath>
    </template>

    <template id="portal_my_task_override" inherit_id="project.portal_my_task">
        <xpath expr="//small[contains(@class, 'text-muted')]" position="replace">
            <small class="text-muted d-none d-md-inline"> (#<span t-field="task.code"/>)</small>
        </xpath>
    </template>
</odoo>
